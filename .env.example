## Option A: provide a full SQLAlchemy connection string.
MYSQL_URL=

## Option B: provide the DB_* pieces below. They will be ignored if MYSQL_URL is set.
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=five-l
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Gmail SMTP password reset emails:
# 1. Turn on 2-Step Verification in your Google Account.
# 2. Create a Google App Password for this backend.
# 3. Put the 16-character app password below. Do not use your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=20
EMAIL_DEV_FALLBACK=false
RESET_CODE_EXPIRY_MINUTES=15
FIVE_L_RESET_DB=false
